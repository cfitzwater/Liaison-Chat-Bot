# .env.example
# This is a template for the .env file.
# Copy this file to .env and replace the values with your actual configuration.
# DO NOT put real passwords or secrets in this file, as it is tracked in version control.

# Set to a secure, randomly generated string in production
SECRET_KEY=replace_me_with_a_secure_random_string

# Your Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Set to False when deploying to production
FLASK_DEBUG=False

# PostgreSQL Database connection string
DATABASE_URL=postgresql://username:password@localhost:5432/database_name